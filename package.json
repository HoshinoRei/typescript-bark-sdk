{
  "name": "@hoshinorei/bark-sdk",
  "version": "0.8.0",
  "description": "A Bun SDK for the Bark API v2",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./mod.ts",
      "bun": "./mod.ts",
      "default": "./mod.ts"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "mod.ts",
    "bark_client.ts",
    "bark_message_builder.ts",
    "enums/**/*.ts",
    "errors/**/*.ts",
    "types/**/*.ts",
    "internal/**/*.ts"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "pack": "bun pm pack --dry-run",
    "prepublishOnly": "bun run validate",
    "test": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=test-result/bun-coverage --reporter=junit --reporter-outfile=test-result/bun-junit.xml tests",
    "validate": "bun run fmt:check && bun run lint:check && bun run check && bun run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bun": "^1.4.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-class-members": "^1.22.1",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "prettier-plugin-packagejson": "^3.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
